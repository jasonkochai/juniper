# Copy to juniper.local.env (git-ignored) and fill in. No secrets here:
# keys and passwords live only in .env on the host.
# scripts/render.py fills the {{PLACEHOLDERS}} in host/ with these values.
# Shell-sourceable: quote values with spaces.

# Where Juniper runs (see docs/hosts.md):
#   ugos  = UGREEN NAS (UGOS, userspace Tailscale)
#   linux = any always-on Linux box: Raspberry Pi (64-bit OS), mini PC, other NAS, VPS
#   local = this computer, with Docker Desktop (for trying it out)
HOST_TYPE=linux
# Data folder on the host. ugos: /volume1/docker/openclaw  linux: /opt/juniper  local: ~/juniper-data (absolute path)
JUNIPER_DIR=/opt/juniper
# How Claude Code reaches the host: an ssh alias or user@host. Empty for local.
HOST_SSH=pi
# Address you open the Control UI from: http://<host tailscale ip>:18789, or http://localhost:18789 for local
CONTROL_UI_ORIGIN=http://100.x.y.z:18789

# Who you are
OWNER_NAME="Your Name"
TIMEZONE=Europe/Berlin

# Telegram forum group (step 1.9). Group ID starts with -100. General is topic 1.
TELEGRAM_GROUP_ID=-1001234567890
CAL_TOPIC_ID=2
EVENTS_TOPIC_ID=3
EMAIL_TOPIC_ID=4
NEWS_TOPIC_ID=5
COMMENTS_TOPIC_ID=6

# Phase 2: the "Agent" calendar URL, ends with /
AGENT_CALENDAR_URL=

# Phase 5: Composio MCP server
COMPOSIO_SERVER_ID=
COMPOSIO_USER_ID=
