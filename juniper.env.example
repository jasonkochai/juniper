# Copy to juniper.local.env (git-ignored) and fill in. No secrets here:
# keys and passwords live only in .env on the host.
# scripts/render.py fills the {{PLACEHOLDERS}} in host/ with these values.
# Shell-sourceable: quote values with spaces.

# Where Juniper runs (see docs/hosts.md):
#   ugos  = UGREEN home server (UGOS, userspace Tailscale)
#   linux = any always-on Linux box: Raspberry Pi (64-bit OS), mini PC, other home servers, VPS
#   local = this computer, with Docker Desktop (for trying it out)
HOST_TYPE=linux
# Data folder on the host. ugos: /volume1/docker/openclaw  linux: /opt/juniper  local: ~/juniper-data (absolute path)
JUNIPER_DIR=/opt/juniper
# How Claude Code reaches the host: an ssh alias or user@host. Empty for local.
HOST_SSH=pi
# Address you open the Control UI from: http://<host tailscale ip>:18789 (e.g. http://100.101.102.103:18789), or http://localhost:18789 for local
CONTROL_UI_ORIGIN=

# Who you are
OWNER_NAME="Your Name"
TIMEZONE=Europe/Berlin

# Telegram forum group (step 1.9, host.sh ids). Group ID starts with -100. General is topic 1.
TELEGRAM_GROUP_ID=
CAL_TOPIC_ID=
EVENTS_TOPIC_ID=
EMAIL_TOPIC_ID=
NEWS_TOPIC_ID=

# Phase 2: the "Agent" calendar URL, ends with /
AGENT_CALENDAR_URL=

