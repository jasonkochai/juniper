# Copy to juniper.local.env (git-ignored) and fill in. No secrets here:
# keys and passwords live only in .env on the NAS.
# scripts/render.py fills the {{PLACEHOLDERS}} in nas/ with these values.
# Shell-sourceable: quote values with spaces.

# Who you are (goes into USER.md)
OWNER_NAME="Your Name"

# How Claude Code reaches the NAS (an ssh host alias or user@host)
NAS_SSH=nas
NAS_TAILSCALE_IP=100.x.y.z

# Telegram forum group (step 1.9). Group ID starts with -100. General is topic 1.
TELEGRAM_GROUP_ID=-1001234567890
CAL_TOPIC_ID=2
EVENTS_TOPIC_ID=3
EMAIL_TOPIC_ID=4
NEWS_TOPIC_ID=5
COMMENTS_TOPIC_ID=6

# Phase 2: the "Agent" calendar URL, ends with /
AGENT_CALENDAR_URL=

# Phase 5: Composio MCP server
COMPOSIO_SERVER_ID=
COMPOSIO_USER_ID=
