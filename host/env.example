# $JUNIPER_DIR/.env (mode 600). Secrets live ONLY here.
# `host.sh env` copies this file and generates OPENCLAW_GATEWAY_TOKEN.
# Fill in the rest on the host: sudo nano "$JUNIPER_DIR/.env" (no sudo on a local install)
# Then apply with: docker compose -p openclaw-agents up -d openclaw-gateway (not restart)
OPENCLAW_GATEWAY_TOKEN=REPLACE_ME
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_OWNER_ID=123456789
ANTHROPIC_API_KEY=sk-ant-REPLACE
GEMINI_API_KEY=REPLACE
BRAVE_API_KEY=REPLACE_IN_PHASE_4
ICLOUD_USER=you@icloud.com
ICLOUD_MAIL_APP_PASSWORD=REPLACE_IN_PHASE_2
ICLOUD_CAL_APP_PASSWORD=REPLACE_IN_PHASE_2
COMPOSIO_API_KEY=REPLACE_IN_PHASE_5

# Not secret, read by docker compose. Leave unset for the defaults.
# GATEWAY_MEM_LIMIT=3g                  # measured ~1.7 GB in use; 2g got OOM-killed
# OBSIDIAN_ASSISTANT_DIR=/path/to/vault/Assistant   # local install: mount the vault folder directly
