# /volume1/docker/openclaw/.env (mode 600, owned by root). Secrets live ONLY here.
# `nas.sh env` copies this file and generates OPENCLAW_GATEWAY_TOKEN.
# Fill in the rest on the NAS with: sudo nano /volume1/docker/openclaw/.env
# Then apply with: sudo docker compose -p openclaw-agents up -d openclaw-gateway (not restart)
OPENCLAW_GATEWAY_TOKEN=REPLACE_ME
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_OWNER_ID=123456789
ANTHROPIC_API_KEY=sk-ant-REPLACE
GEMINI_API_KEY=REPLACE
BRAVE_API_KEY=REPLACE_IN_PHASE_4
ICLOUD_USER=you@icloud.com
ICLOUD_MAIL_APP_PASSWORD=REPLACE_IN_PHASE_2
ICLOUD_CAL_APP_PASSWORD=REPLACE_IN_PHASE_2
COMPOSIO_API_KEY=REPLACE_IN_PHASE_5
